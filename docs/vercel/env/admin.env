# =============================================================================
# Projeto Vercel: Gestão  ·  Root Directory: apps/admin  ·  Framework: Vite
# Vercel → Project → Settings → Environment Variables → "Paste .env"
#
# As variáveis VITE_* entram no código no momento do build: depois de as
# alterar é preciso fazer Redeploy (Deployments → ⋯ → Redeploy).
# =============================================================================

# Domínio do projeto da API, sem barra final.
VITE_API_URL=https://COLE_AQUI_O_DOMINIO_DA_API.vercel.app

# Usado no botão "ver no site" de cada obra.
VITE_PUBLIC_SITE_URL=https://obragoito.pt

# =============================================================================
# Projeto Vercel: API  ·  Root Directory: apps/api  ·  Framework Preset: Other
# Vercel → Project → Settings → Environment Variables → "Paste .env"
# Marque Production, Preview e Development. Substitua tudo o que diz COLE_AQUI_.
# As linhas começadas por # são ignoradas.
# =============================================================================

# --- Obrigatórias ------------------------------------------------------------
NODE_ENV=production
COOKIE_SECURE=true
COOKIE_SAMESITE=none

# Supabase → Connect → Transaction pooler (porta 6543).
# O host tem o formato aws-0-<região>.pooler.supabase.com e a palavra-passe é a
# da base de dados (Database → Database password), não a chave da API.
DATABASE_URL=postgresql://postgres.kvennlxtzhxlavksiyrc:COLE_AQUI_A_PALAVRA_PASSE@COLE_AQUI_O_HOST_DO_POOLER:6543/postgres?sslmode=require

# 32+ caracteres aleatórios. Gerar com:
# node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET=COLE_AQUI_UM_SEGREDO_DE_32_OU_MAIS_CARACTERES

# --- Supabase (documentos e fotografias) -------------------------------------
SUPABASE_URL=https://kvennlxtzhxlavksiyrc.supabase.co
SUPABASE_ANON_KEY=sb_publishable__xzRf3vkZf0POaNkF2z5ug_hlaBcisU
# Project Settings → API Keys → Secret keys. Só existe na API, nunca no browser.
SUPABASE_SERVICE_ROLE_KEY=COLE_AQUI_A_CHAVE_SECRETA_DO_SUPABASE
SUPABASE_STORAGE_BUCKET=project-files

# --- Domínios -----------------------------------------------------------------
PUBLIC_SITE_URL=https://obragoito.pt
# Domínios dos projetos Vercel que falam com a API, separados por vírgula, sem
# barra final. Sem isto os portais não conseguem entrar: a API recusa origens
# que não estejam nesta lista.
PUBLIC_ORIGINS=https://COLE_AQUI_O_SITE.vercel.app,https://COLE_AQUI_A_GESTAO.vercel.app,https://COLE_AQUI_OS_CLIENTES.vercel.app,https://COLE_AQUI_A_EQUIPA.vercel.app,https://COLE_AQUI_O_PORTAL_DEV.vercel.app

# --- Agendamento (Vercel Cron → /api/cron/daily) -----------------------------
CRON_SECRET=COLE_AQUI_UM_SEGREDO_DO_AGENDAMENTO

# --- Email (opcional) ---------------------------------------------------------
# Sem SMTP nem RESEND os pedidos de orçamento ficam apenas na base de dados.
QUOTE_NOTIFY_EMAIL=obragoito@obragoito.pt
EMAIL_FROM=website@obragoito.pt
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=COLE_AQUI
# SMTP_PASS=COLE_AQUI
# RESEND_API_KEY=COLE_AQUI

# --- Resumos dos relatórios diários (opcional) -------------------------------
# GEMINI_API_KEY=COLE_AQUI
GEMINI_MODEL=gemini-2.0-flash

# --- Transcrição de voz (opcional) -------------------------------------------
# TRANSCRIPTION_PROVIDER=openai
# OPENAI_API_KEY=COLE_AQUI
TRANSCRIPTION_MODEL=whisper-1

# --- Limites ------------------------------------------------------------------
# A Vercel recusa pedidos com mais de 4,5 MB.
MAX_UPLOAD_MB=4

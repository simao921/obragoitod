# API — valores de ambiente. Copie para apps/api/.env em desenvolvimento local.
# NUNCA coloque segredos reais neste ficheiro nem no repositório.

# Base de dados (Supabase ou Postgres local)
DATABASE_URL=postgres://obragoito:obragoito@localhost:5432/obragoito

# Assina sessões e URLs assinados. Mínimo 24 caracteres.
# Gerar: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET=

API_PORT=4000
NODE_ENV=development

# Em produção (HTTPS) deve ser true.
COOKIE_SECURE=false

# Origens adicionais autorizadas para pedidos com credenciais.
# PUBLIC_ORIGINS=https://gestao.obragoito.pt,https://clientes.obragoito.pt

# Documentos privados (modo local)
UPLOAD_DIR=./data/uploads
MAX_UPLOAD_MB=12

# --- Projeto Supabase da Obragoito ----------------------------------------
# A chave publishable é pública por desenho (vai para o browser).
# A service role é secreta: nunca a coloque no repositório nem no frontend.
SUPABASE_URL=https://kvennlxtzhxlavksiyrc.supabase.co
SUPABASE_ANON_KEY=sb_publishable__xzRf3vkZf0POaNkF2z5ug_hlaBcisU
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=project-files

# --- Gemini (resumos dos relatórios diários) -------------------------------
# Pode também ser definida na gestão > Definições ou no portal dev > Integrações.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# --- Agendamento -----------------------------------------------------------
# Segredo do fecho diário automático (Vercel Cron envia Authorization: Bearer).
CRON_SECRET=
PUBLIC_SITE_URL=https://obragoito.pt

# --- Transcrição de voz (opcional) ----------------------------------------
# Sem estas variáveis a gravação aparece como indisponível nos portais.
TRANSCRIPTION_PROVIDER=
OPENAI_API_KEY=
TRANSCRIPTION_MODEL=whisper-1

# --- Email (opcional) ------------------------------------------------------
# Sem RESEND_API_KEY os pedidos de orçamento ficam apenas na base de dados.
RESEND_API_KEY=
QUOTE_NOTIFY_EMAIL=obragoito@obragoito.pt
EMAIL_FROM=website@obragoito.pt

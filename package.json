{
  "name": "obragoito",
  "version": "1.0.0",
  "private": true,
  "description": "Presença digital Obragoito — site público, portais privados e API.",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:web": "npm run dev --workspace @obragoito/web",
    "dev:admin": "npm run dev --workspace @obragoito/admin",
    "dev:client": "npm run dev --workspace @obragoito/client",
    "dev:worker": "npm run dev --workspace @obragoito/worker",
    "dev:dev": "npm run dev --workspace @obragoito/dev",
    "dev:dev": "npm run dev --workspace @obragoito/dev",
    "dev:api": "npm run dev --workspace @obragoito/api",
    "build": "npm run build --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspace @obragoito/api",
    "db:migrate": "npm run db:migrate --workspace @obragoito/api",
    "db:seed": "npm run db:seed --workspace @obragoito/api",
    "db:seed-accounts": "npm run db:seed-accounts --workspace @obragoito/api",
    "db:seed-accounts": "npm run db:seed-accounts --workspace @obragoito/api",
    "create-admin": "npm run create-admin --workspace @obragoito/api --"
  },
  "devDependencies": {
    "typescript": "5.6.3"
  },
  "engines": {
    "node": ">=20"
  }
}
